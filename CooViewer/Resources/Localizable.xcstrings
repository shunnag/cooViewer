    "%lld / %lld pages" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld ページ"
          }
        }
      }
    },
    "%lld%%" : {
      "comment" : "A percentage value. The argument is a percentage value.",
      "isCommentAutoGenerated" : true
    },
    "A model (about 9 MB) will be downloaded on first use. Each page is upscaled 4× by a neural network — this is the heaviest level: a page can take several seconds, and results are cached on disk." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回にモデル(約 9 MB)をダウンロードします。各ページをニューラルネットワークで 4 倍に拡大する最も重い方式で、ページの処理に数秒かかることがあります(結果はディスクにキャッシュされます)。"
          }
        }
      }
    },
    "A small model (about 1.2 MB) will be downloaded on first use. This method is much heavier: displaying a page can take a few seconds." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回に小さなモデル(約 1.2 MB)をダウンロードします。この方式は処理が重く、ページの表示に数秒かかることがあります。"
          }
        }
      }
    },
    "About cooViewer" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cooViewer について"
          }
        }
      }
    },
    "Action:" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動作:"
          }
        }
      }
    },
    "Actions marked “(by side)” decide forward/back by which half of the view you use." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「(位置で判定)」の動作は、操作した位置が画面の左右どちらの半分かで進む/戻るが決まります。"
          }
        }
      }
    },
    "Actions marked “(by side)” decide forward/back by which half of the view you use. “+” adds an input; choosing one that’s in use moves it here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「(位置で判定)」の動作は、操作した位置が画面の左右どちらの半分かで進む/戻るが決まります。「+」で入力を追加できます。他の機能で使用中の入力を選ぶと、この機能へ付け替えられます。"
          }
        }
      }
    },
